{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabby",
  "version": "1.0.0",
  "identifier": "it.pisco.tabby",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tabby",
        "width": 460,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "all",
        "title": "Tutte le note",
        "url": "/all",
        "width": 1180,
        "height": 640,
        "minWidth": 980,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "RobyPisco",
    "category": "Productivity",
    "shortDescription": "Sticky notes ancorate al bordo dello schermo",
    "longDescription": "Note adesive sul bordo dello schermo: ricerca, promemoria con notifiche, caselle da spuntare, immagini, tag, cartelle, link tra note ed export.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Italian": "nsis/Italian.nsh"
        },
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "it-IT"
      }
    }
  }
}
